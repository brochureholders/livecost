# -----------------------------------------------------------------------------
# LiveCost environment configuration
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored; never commit secrets.
# -----------------------------------------------------------------------------

# Public site URL. Used in canonical links, sitemap, robots.txt, Open Graph.
# In production set this to your deployed URL, e.g. https://livecost.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — required for reading city data and for the ingest scripts.
# Get the URL + anon key from Project Settings → API on your Supabase project.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Used by the ingest scripts and the /api/pageview route to write
# data past RLS. Keep this out of any client bundle — Next.js does not expose
# variables without the NEXT_PUBLIC_ prefix, so this stays server-side.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Data source API keys (used only by scripts/ingest-*.ts)
# -----------------------------------------------------------------------------

# US Census Bureau ACS 5-Year API. Request a key at
# https://api.census.gov/data/key_signup.html (free, instant).
CENSUS_API_KEY=your-census-api-key

# US Bureau of Labor Statistics CPI-U API. Register at
# https://data.bls.gov/registrationEngine/ (free). Key gets 500 req/day.
BLS_API_KEY=your-bls-api-key

# Unified api.data.gov key used by the FBI Crime Data Explorer ingest (and
# other federal APIs hosted on api.data.gov). Free, instant, 1000 req/hour:
# https://api.data.gov/signup/
API_DATA_GOV_KEY=your-api-data-gov-key

# Walk Score API (free tier: 5000 calls/day). Used by ingest-walkscore.ts
# to populate walk_score / transit_score / bike_score on city_quality.
# Sign up: https://www.walkscore.com/professional/api-sign-up.php
WALKSCORE_API_KEY=your-walkscore-api-key

# EPA AQS (Air Quality System) credentials. Used by ingest-aqs.ts to
# populate air_quality_index. Free forever; registration required at
# https://aqs.epa.gov/data/api/signup?email=your@email — both the email
# and the key returned are sent on every request.
AQS_EMAIL=your@email.com
AQS_KEY=your-aqs-key
